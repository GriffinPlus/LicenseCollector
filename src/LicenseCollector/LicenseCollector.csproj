<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFrameworks>net11.0</TargetFrameworks>
		<BuildVs_Override_IntermediateOutputPath>true</BuildVs_Override_IntermediateOutputPath>
		<BuildVs_Override_OutputPath>true</BuildVs_Override_OutputPath>
		<StartupObject>GriffinPlus.LicenseCollector.Program</StartupObject>
		<RootNamespace>GriffinPlus.LicenseCollector</RootNamespace>
		<PreserveCompilationContext>true</PreserveCompilationContext>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="CommandLineParser" Version="2.9.1" />
		<PackageReference Include="GriffinPlus.Lib.Logging" Version="7.1.4" />
		<PackageReference Include="Microsoft.AspNetCore.Razor.Language" Version="6.0.36" />
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
		<PackageReference Include="Microsoft.VisualStudio.SolutionPersistence" Version="1.0.52" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
	</ItemGroup>

</Project>